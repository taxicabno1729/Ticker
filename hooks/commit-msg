#!/bin/bash
# Enforces commit message format from git skill:
#   <type>: <short summary>
# Types: feat, fix, docs, style, refactor, test, chore

commit_msg=$(cat "$1")

# Allow merge commits and WIP commits unchanged
if echo "$commit_msg" | grep -qE "^(Merge|Revert|WIP)"; then
    exit 0
fi

pattern="^(feat|fix|docs|style|refactor|test|chore)(\(.+\))?: .{1,72}$"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
    echo ""
    echo "  ERROR: Commit message does not match required format."
    echo ""
    echo "  Expected:  <type>: <short summary>"
    echo "  Received:  $commit_msg"
    echo ""
    echo "  Valid types: feat, fix, docs, style, refactor, test, chore"
    echo ""
    echo "  Examples:"
    echo "    feat: add portfolio ETH balance display"
    echo "    fix: correct token price calculation"
    echo "    chore: update dependencies"
    echo ""
    exit 1
fi
